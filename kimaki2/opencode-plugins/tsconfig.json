{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ESNext",
    "lib": ["ESNext"],
    "noEmit": true,
    "declaration": false,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["."]
}
