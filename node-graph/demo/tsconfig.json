{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "declaration": false,
    "skipLibCheck": true,
    "noImplicitAny": false
  },
  "include": ["."]
}
