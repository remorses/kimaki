{
  "name": "@kimaki/plugin-fallback",
  "version": "0.0.0",
  "type": "module",
  "description": "OpenCode V2 plugin that switches account or model per session on rate limit, quota and overload errors.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "rimraf dist \"*.tsbuildinfo\" && pnpm build",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "keywords": [
    "opencode",
    "plugin",
    "fallback",
    "rate-limit",
    "quota",
    "accounts",
    "model-fallback"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/remorses/kimaki",
    "directory": "opencode-fallback"
  },
  "homepage": "https://github.com/remorses/kimaki",
  "bugs": "https://github.com/remorses/kimaki/issues",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@opencode/cli": "2.0.22",
    "@opencode/client": "2.0.22",
    "@opencode/plugin": "2.0.22",
    "@types/node": "^24.3.0",
    "rimraf": "^6.0.1"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.22"
  }
}
