{
  "compilerOptions": {
    "lib": ["ESNext", "ESNext.Disposable"],
    // ES2024, not ESNext: tsc must downlevel `await using`, Node 22 cannot parse it.
    "target": "ES2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    // Incremental: tsc only rewrites changed outputs, so a build does not touch
    // unchanged dist/plugin files (OpenCode reloads all plugins on any write).
    "incremental": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false
  },
  "include": ["src"]
}
